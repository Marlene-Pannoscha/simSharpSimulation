import simpy
import random
import numpy as np
import matplotlib.pyplot as plt
from scipy import stats

# --- 1. PARAMETER ---
RANDOM_SEED = 42  # gleiche Zufallswerte bei jedem Lauf.
# MITTLERE_ANKUNFTSZEIT = 15 # Mittelwert der Ankunftszeit der Patienten (in Minuten)
MITTLERE_BEHANDLUNGSZEIT = 5 # durchschnittliche Dauer, wie lange ein Patient beim Arzt ist. Mittelwert der Zwischen Ankunftzeit der Patentien größer als Mittelwert der Bearbeitungszeit
SIMULATIONSDAUER = 480  # 8 Stunden Simulation für stabilere Statistik
ANZAHL_AERZTE = 3

# NEU: Parameter für die Inversionsmethode 
ANZAHL_PATIENTEN_TAG = 100 # Wie viele Patienten erwarten wir insgesamt heute?
ERWARTUNGSWERT = 180        # Wann ist am meisten los? (Minute 240 = nach 2 Stunden)
STANDARDABWEICHUNG = 80     # Wie breit ist die Glockenkurve? (Standardabweichung in Minuten)

# --- 2. DATENSAMMLUNG & DATEI-EXPORT ---
trace_data = []  # Liste, um Ereignisse während der Sim zu sammeln
wartezeiten = [] # Liste, um die Wartezeiten der Patienten zu sammeln
echte_ankunftszeiten = [] # NEU: Liste für die tatsächlichen Ankunftszeiten

def log_event(zeit, event_typ, patient_id):
    """Speichert ein Ereignis in unserer Trace-Liste."""
    time_str = f"{zeit:.2f}".zfill(6) # Formatierte Zeit
    log_entry = f"{time_str};{event_typ};{patient_id}"
    trace_data.append(log_entry)

# --- 3. DER PATIENTEN-PROZESS (Der logische Weg) ---
def patient(env, patient_id, arzt):
    # EREIGNIS 1: Patient betritt die Klinik
    log_event(env.now, "betritt_klinik", patient_id)
    ankunftszeit = env.now  # now: Abruf der aktuellen Simulatioinszeit
    echte_ankunftszeiten.append(ankunftszeit) # NEU: Speichere Ankunftszeit für das Diagramm
    
    with arzt.request() as anfrage:
        # EREIGNIS 2: Patient geht zur Warteschlange
        log_event(env.now, "geht_zu_warteschlange", patient_id)
        yield anfrage # pausiert den Prozess, bis ein Arzt frei wird
        
        # EREIGNIS 3: Patient verlässt die Warteschlange
        wartezeit = env.now - ankunftszeit
        wartezeiten.append(wartezeit)
        log_event(env.now, "verlaesst_warteschlange", patient_id)
        # EREIGNIS 4: Patient geht zum Arzt
        log_event(env.now, "geht_zu_arzt", patient_id)
        
        behandlungsdauer = random.expovariate(1.0 / MITTLERE_BEHANDLUNGSZEIT)
        yield env.timeout(behandlungsdauer) # Zeitspanne "pausiert"
    # Die 'with'-Anweisung ist hier zu Ende. Der Arzt wird automatisch freigegeben.

    # EREIGNIS 5: Patient verlässt den Arzt
    log_event(env.now, "verlaesst_arzt", patient_id)
    # EREIGNIS 6: Patient verlässt die Klinik
    log_event(env.now, "verlaesst_klinik", patient_id)

# --- 4. DIE QUELLE (NEU) ---
def patienten_generator(env, arzt):
    # Schritt 1: Wir generieren die Ankunftszeiten nach der Normalverteilung
    # np.random.seed(RANDOM_SEED)
    ankunftszeiten = np.random.normal(loc=ERWARTUNGSWERT, scale=STANDARDABWEICHUNG, size=ANZAHL_PATIENTEN_TAG)
    
    # Schritt 2: Zeiten filtern, die außerhalb der Öffnungszeiten liegen (<0 oder >480)
    ankunftszeiten = [z for z in ankunftszeiten if 0 <= z <= SIMULATIONSDAUER]
    
    # Schritt 3: Zeiten sortieren, wichtig für die Simulation.
    ankunftszeiten.sort()
    
    patient_count = 1
    # Schritt 4: Die Simulation springt nun von Ereignis zu Ereignis
    for ankunftszeit in ankunftszeiten:
        # Berechne, wie lange die Simulation "warten" muss, bis dieser Patient ankommt, dies von Simulation, nicht von der realen Zeit.
        warte_bis_ankunft = ankunftszeit - env.now
        if warte_bis_ankunft > 0:
            yield env.timeout(warte_bis_ankunft)
        
        # Wenn die Zeit erreicht ist, wird der Patient in die Klinik geschickt
        env.process(patient(env, patient_count, arzt))
        patient_count += 1
    

# --- 5. HAUPTPROGRAMM (Setup & Start) ---
print("--- Start der SimPy-Klinik-Simulation ---")
#random.seed(RANDOM_SEED) # initialisiert den Zufallsgenerator mit einem festen Startwert
env = simpy.Environment() # als Uhr der simulation, erwaltet die Zeit dass alle Ereignisse in der richtigen Reihenfolge ablaufen.
arzt = simpy.Resource(env, capacity=ANZAHL_AERZTE)
env.process(patienten_generator(env, arzt)) # startet den Patienten-Generator als Prozess in der Simulationsumgebung
env.run(until=SIMULATIONSDAUER)
print("--- Ende der SimPy-Simulation. ---")

# --- 6. VISUALISIERUNG (Diagramme) ---
print("Generiere Diagramme (Wartezeiten, Ankünfte, Theorie)...")

# Zeitpunkte für die x-Achse (0 bis 480 min) für theoretische Kurven
x = np.linspace(0, SIMULATIONSDAUER, 500)
pdf = stats.norm.pdf(x, ERWARTUNGSWERT, STANDARDABWEICHUNG)
cdf = stats.norm.cdf(x, ERWARTUNGSWERT, STANDARDABWEICHUNG)

# --- 6.1. Diagramm 1: Nur PDF & CDF (Theorie) ---
fig1, ax1_theorie = plt.subplots(figsize=(10, 6))

color_pdf = 'tab:blue'
ax1_theorie.set_xlabel('Zeit in Minuten (0 bis 480)')
ax1_theorie.set_ylabel('Wahrscheinlichkeitsdichte (PDF)', color=color_pdf)
ax1_theorie.plot(x, pdf, color=color_pdf, linewidth=2, label='PDF (Dichtefunktion)')
ax1_theorie.tick_params(axis='y', labelcolor=color_pdf)

ax2_theorie = ax1_theorie.twinx()
color_cdf = 'tab:red'
ax2_theorie.set_ylabel('Kumulierte Wahrscheinlichkeit (CDF)', color=color_cdf)
ax2_theorie.plot(x, cdf, color=color_cdf, linestyle='--', linewidth=2, label='CDF (Verteilungsfunktion)')
ax2_theorie.tick_params(axis='y', labelcolor=color_cdf)

plt.title(f"Theoretische Patientenankünfte (Normalverteilung)\n(Erwartungswert: {ERWARTUNGSWERT}, StdAbw: {STANDARDABWEICHUNG})")
fig1.tight_layout()
plt.savefig('ankunftsverteilung_theorie_pdf_cdf.png')
print("--- Diagramm 1: ankunftsverteilung_theorie_pdf_cdf.png gespeichert. ---")

# --- 6.2. Diagramm 2: Histogramm der tatsächlichen Ankünfte + PDF & CDF ---
fig2, ax1_sim = plt.subplots(figsize=(10, 6))

# Bei anzahl_bins = 24: 480 / 24 = 20 Minuten. Jeder Balken fasst also einen Zeitraum von 20 Minuten zusammen (z.B. von Minute 0 bis 20, von 20 bis 40...).
anzahl_bins = 24 # HINWEIS: Man kann das ändern (z.B. auf 16 für halbe Stunden oder 48 für 10-Minuten-Intervalle)
balken_breite = SIMULATIONSDAUER / anzahl_bins
counts, bins, patches = ax1_sim.hist(echte_ankunftszeiten, bins=anzahl_bins, range=(0, SIMULATIONSDAUER), color='lightblue', edgecolor='black', alpha=0.6, label='Tatsächliche Ankünfte (Histogramm)')

ax1_sim.set_xlabel('Zeit der Simulation in Minuten (0 bis 480)')
ax1_sim.set_ylabel(f'Anzahl der Patienten', color='black') # Y-Achse dynamisch beschriftet
ax1_sim.tick_params(axis='y', labelcolor='black')

skalierte_pdf = pdf * len(echte_ankunftszeiten) * balken_breite
ax1_sim.plot(x, skalierte_pdf, color='darkblue', linewidth=3, label='PDF (Dichtefunktion)')
ax1_sim.legend(loc='upper left')

ax2_sim = ax1_sim.twinx()
ax2_sim.set_ylabel('Kumulierte Wahrscheinlichkeit (CDF)', color=color_cdf)
ax2_sim.plot(x, cdf, color=color_cdf, linestyle='--', linewidth=3, label='CDF (Verteilungsfunktion)')
ax2_sim.tick_params(axis='y', labelcolor=color_cdf)
ax2_sim.legend(loc='upper right')

plt.title(f"Simulation vs. Theorie: Ankünfte\n(Mittelwert: {ERWARTUNGSWERT}, StdAbw: {STANDARDABWEICHUNG})")
fig2.tight_layout()
plt.savefig('ankuenfte_simulation_vs_theorie.png')
print("--- Diagramm 2: ankuenfte_simulation_vs_theorie.png gespeichert. ---")

# --- 6.3. Diagramm 3: Das ALTE Histogramm der Wartezeiten ---
plt.figure(figsize=(10, 6))
plt.hist(wartezeiten, bins=20, color='teal', edgecolor='black', alpha=0.7)
plt.title(f"Verteilung der Wartezeiten (Ärzte: {ANZAHL_AERZTE})")
plt.xlabel("Wartezeit in Minuten")
plt.ylabel("Anzahl der Patienten")
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.savefig('wartezeiten_histogramm.png')
print("--- Diagramm 3: wartezeiten_histogramm.png gespeichert. ---")


# --- 7. EXPORT IN TEXTDATEI ---
print("--- Speichere Trace-File: klinik_trace.txt ---")
with open("klinik_trace.txt", "w") as f:
    for entry in trace_data:
        f.write(entry + "\n")
print("--- Trace-File erfolgreich gespeichert. ---")
