<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Schrittweise Extraktion: dieselben Quellen, keine Kopie der Fachlogik. -->
  <ItemGroup>
    <Compile Include="../simSharpSimulation/Prozess/**/*.cs" LinkBase="Prozess" />
    <Compile Include="../simSharpSimulation/Ressourcen/*.cs" LinkBase="Ressourcen" />
    <Compile Include="../simSharpSimulation/SimulationKonfiguration.cs" />
    <Compile Include="../simSharpSimulation/SimulationsDaten.cs" />
    <Compile Include="../simSharpSimulation/SimulationLiveEvent.cs" />
    <Compile Include="../simSharpSimulation/SimulationEventQueue.cs" />
    <Compile Include="../simSharpSimulation/ProjektPfade.cs" />
    <Content Include="../simSharpSimulation/Ressourcen/*.json" Link="Ressourcen/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="SimSharp" Version="3.4.2" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>
</Project>
